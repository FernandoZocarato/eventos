{
  "name": "conecta-eventos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "dev:demo": "vite --mode demo --host 0.0.0.0",
    "build:demo": "vue-tsc --noEmit && vite build --mode demo",
    "preview": "vite preview --host 0.0.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "lucide-vue-next": "^0.468.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.4.0",
    "laravel-vite-plugin": "^1.3.0",
    "typescript": "~5.7.0",
    "vue-tsc": "^2.2.0",
    "@types/qrcode": "^1.5.5"
  }
}
